# vcs-rag environment — copy to `.env` (`cp .env.example .env`).
# NEVER commit a filled .env: tokens and private endpoints stay local.
#
# Keep exactly ONE VCS flavor active. The default below is a PUBLIC GitHub
# organization: no token is required (anonymous API limit — 60 requests/hour
# per IP). To use GitLab, comment the GitHub block out and uncomment GitLab.

# ── VCS source: GitHub, public organization (active by default) ──────────
GITHUB_ORG=gorizond
# A token (no scopes needed for public repos) is recommended for the metadata
# lane — issues/MRs/CI — because the anonymous limit is shared per IP.
GITHUB_TOKEN=
# GITHUB_BASE_URL=https://api.github.com   # GitHub Enterprise (optional)

# ── VCS source: GitLab (requires a token) ────────────────────────────────
# GITLAB_GROUP_ID=<group-or-comma-separated-list>
# GITLAB_TOKEN=<read_api-token>
# GITLAB_BASE_URL=https://gitlab.com       # self-hosted GitLab (optional)

# ── Embeddings ───────────────────────────────────────────────────────────
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=bge-m3
EMBEDDINGS_DIM=1024
# An Ollama/LM Studio running on the host — the "Deploy example" default
# (on Linux the compose file adds host.docker.internal:host-gateway).
# The demo override (docker-compose.demo.yml) replaces this with the bundled
# Ollama service: http://ollama:11434.
EMBEDDINGS_BASE_URL=http://host.docker.internal:11434
# EMBEDDINGS_BATCH=32                      # embedding batch size

# ── Qdrant / NATS / instance ─────────────────────────────────────────────
# QDRANT_URL=http://localhost:6334
# QDRANT_API_KEY=                          # Qdrant Cloud / API-key deployments
# QDRANT_COLLECTION=vcs_rag
# QDRANT_GRAPH_COLLECTION=vcs_rag_graph      # instance-scoped; must differ from QDRANT_COLLECTION
# NATS_URL=nats://localhost:4222           # empty — refresh/auto-freshness off
# NATS_INSTANCE_ID=default                 # scopes consumer/subjects/KV
# WORKER_INTERVAL=60s                      # the lane tick is a ceiling
# WORKER_DISCOVERY_MIN_INTERVAL=10m        # cache the listing (provider budget)
# WORKER_GC_DRY_RUN=true                   # GC kill-switch: observe-only
# WORKER_GRAPH_INTERVAL=30m                # graph lane tick
# WORKER_GRAPH_SCHEMA_VER=1                # part of the graph uuid5 namespace
# WORKER_GRAPH_MAX_REPOS_PER_PASS=5        # graph pass cap
# MCP_TRANSPORT=sse
# MCP_ADDR=:8080

# Pin the image used by the compose stacks (default: latest):
# VCS_RAG_IMAGE=ghcr.io/gorizond/vcs-rag:latest
